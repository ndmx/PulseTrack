rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to all users (public data)
    match /approval_ratings/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /approval_trends_daily/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /approval_trends_monthly/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /sentiment_breakdown/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /state_demographics/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Allow users to submit opinions (write-only)
    match /raw_inputs/{document=**} {
      allow read, write: if false;
    }

    match /submission_rate_limits/{document=**} {
      allow read, write: if false;
    }
    
    // Admin-only collections
    match /reference_data/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /verified_polls/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    
    match /audit_log/{document=**} {
      allow read, write: if false;
    }
  }
}
