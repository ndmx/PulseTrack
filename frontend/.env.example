VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Enable browser incident submission only after the web app is registered with
# Firebase App Check (reCAPTCHA Enterprise) and the PulseTrackr callable is live.
# VITE_FIREBASE_APP_CHECK_SITE_KEY=your_recaptcha_enterprise_site_key
# VITE_PULSETRACKR_REPORTING_ENABLED=true

# Optional when local Vite should call a deployed function instead of the emulator proxy.
# VITE_SUBMIT_OPINION_URL=https://your-domain.example/api/submit_opinion

# Optional when Snapstats assets move from Firebase Hosting to a bucket/CDN.
# VITE_SNAPSTATS_BASE_URL=https://storage.googleapis.com/your-bucket/snapstats
